{
  "opencollection": "1.0.0",
  "info": {
    "name": "Frame.io Account Permissions Users API",
    "version": "v4.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://ims-na1.adobelogin.com/ims/authorize/v2",
      "accessTokenUrl": "https://ims-na1.adobelogin.com/ims/token/v3",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "User details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.frame.io/v4/me"
          },
          "docs": "Inspect details of the user associated with the bearer token. <br/>Rate Limits: 100 calls per 1.00 minute(s) per account_user"
        }
      ]
    }
  ],
  "bundled": true
}